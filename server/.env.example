# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas for Production or local MongoDB)
# Leave blank or unconfigured to automatically use the safe in-memory fallback during local evaluation
MONGODB_URI=

